# Python environments and caches
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/

# Editors, operating systems and tooling
.DS_Store
*.swp
*~
.claude/

# Compiled and packaged build products
build/
dist/
*.egg-info/
*.so

# Generated work products.  Simulation runs are reproducible from
# simulations.toml, so nothing NNN/data/ holds belongs in the history -- but the
# directory itself does, since every run writes into it and git cannot record an
# empty one.  Hence the placeholder, and nothing else.
data/*
!data/.gitkeep

# Images are generated from the code and the data beside them, so they are not
# carried in the history unless a document depends on one.
*.png
*.svg
*.pdf

# The notebook's figures are the exception: they are the evidence for the
# results and for the cost of producing them, so a reader gets them without
# re-running anything.  results/ holds the physics, scalability/ the timings.
!figures/results/*.pdf
!figures/results/*.png
!figures/scalability/*.pdf
!figures/scalability/*.png
!validation/figures/*.pdf
!validation/figures/*.png

# Large numerical formats
*.npz
*.npy
*.csv
*.json

# The exact reference data is small, cheap to read and slow to regenerate, so
# it is carried rather than recomputed.  This must follow the rule above: in a
# gitignore the last matching pattern wins.
!validation/data/*.csv

# The typeset notes are a deliverable of this repository: the PDF is committed
# so it can be read without a TeX installation, while everything else latexmk
# leaves behind is not.
!Simulator/docs/theory_algorithm_implementation.pdf

# Working notes kept for the assistant's own use: parameter targets and
# convergence measurements that are not part of what this repository publishes.
Simulator/docs/AP_CONVERGENCE_OPEN_WASEP.md
Simulator/docs/KLS_FIRST_ORDER_TARGETS.md

# LaTeX build products.  The sources are the .tex files and what they read --
# .bib, .cls, .bst, .sty -- and the deliverable is the .pdf; everything else a
# TeX run leaves behind is regenerated by the next compile and is ignored.
*.aux
*.log
*.out
*.toc
*.lof
*.lot
*.lol
*.bbl
*.blg
*.bcf
*.run.xml
*.fls
*.fdb_latexmk
*.synctex.gz
*.synctex
*.dvi
*.xdv
*.idx
*.ind
*.ilg
*.glo
*.gls
*.glg
*.acn
*.acr
*.alg
*.ist
*.nav
*.snm
*.vrb
*.brf
*.tdo
*.auxlock
*.figlist
*.makefile
*.pytxcode
_minted-*/

# A working notebook kept out of what this repository publishes.
notebooks/NNN_diffusivity_from_density_profile.ipynb
